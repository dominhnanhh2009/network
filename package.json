{
  "name": "network",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-endpoints.mjs",
    "d1:create": "wrangler d1 create network-db",
    "d1:migrate:local": "wrangler d1 execute network-db --local --file=./schema.sql",
    "d1:migrate:remote": "wrangler d1 execute network-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "typescript": "^5.8.2",
    "wrangler": "^4.147.0"
  }
}
